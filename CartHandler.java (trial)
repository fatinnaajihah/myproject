import com.sun.net.httpserver.HttpHandler;
import com.sun.net.httpserver.HttpExchange;
import java.io.IOException;
import java.io.OutputStream;
import java.util.HashMap;
import java.util.Map;
import java.util.List;
import java.util.ArrayList;
import java.io.InputStream;
import java.nio.charset.StandardCharsets;

public class CartHandler implements HttpHandler {
    private Map<String, List<String>> cart = new HashMap<>();

    @Override
    public void handle(HttpExchange exchange) throws IOException {
        String method = exchange.getRequestMethod();
        if ("POST".equalsIgnoreCase(method)) {
            handlePostRequest(exchange);
        } else {
            handleNotSupported(exchange);
        }
    }

    private void handlePostRequest(HttpExchange exchange) throws IOException {
        InputStream inputStream = exchange.getRequestBody();
        String requestBody = new String(inputStream.readAllBytes(), StandardCharsets.UTF_8);

        // Assuming the request body contains a JSON object with a "productId" field
        String productId = extractProductIdFromRequestBody(requestBody);

        if (productId != null) {
            cart.computeIfAbsent("cart", k -> new ArrayList<>()).add(productId);
            String response = "Product added to cart";
            exchange.sendResponseHeaders(200, response.length());
            OutputStream outputStream = exchange.getResponseBody();
            outputStream.write(response.getBytes());
            outputStream.close();
        } else {
            String response = "Invalid product ID";
            exchange.sendResponseHeaders(400, response.length());
            OutputStream outputStream = exchange.getResponseBody();
            outputStream.write(response.getBytes());
            outputStream.close();
        }
    }

    private void handleNotSupported(HttpExchange exchange) throws IOException {
        String response = "Method not supported";
        exchange.sendResponseHeaders(405, response.length());
        OutputStream outputStream = exchange.getResponseBody();
        outputStream.write(response.getBytes());
        outputStream.close();
    }

    private String extractProductIdFromRequestBody(String requestBody) {
        // Simple extraction logic, assuming the request body is a JSON object with a "productId" field
        // In a real application, use a JSON library like Jackson or Gson to parse the request body
        if (requestBody.contains("\"productId\"")) {
            int startIndex = requestBody.indexOf("\"productId\"") + 12;
            int endIndex = requestBody.indexOf("\"", startIndex);
            return requestBody.substring(startIndex, endIndex);
        }
        return null;
    }
}
